APP_NAME="Family Affairs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://family-affairs.test
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=sw
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# MySQL 8 locally (DBngin) / MariaDB 10.11 on the VPS
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=family_affairs
DB_USERNAME=root
DB_PASSWORD=

# Sessions live in the database so they can be revoked server-side.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Family Affairs
# ---------------------------------------------------------------------------
# Messaging provider: "nextsms" in production. "fake" is ONLY allowed when
# APP_ENV is local or testing — the app refuses to boot with it otherwise.
FA_MESSAGING_DRIVER=fake

# NextSMS (messaging-service.co.tz) — dashboard: Customer Info -> Customization -> API Keys
NEXTSMS_BASE_URL=https://messaging-service.co.tz
NEXTSMS_TOKEN=
# WhatsApp Business account name exactly as registered in the NextSMS dashboard
NEXTSMS_WHATSAPP_ACCOUNT=
# Name of the APPROVED WhatsApp authentication template that carries the
# code in a copy_otp_code button (dashboard: Channels -> Whatsapp Channel -> Whatsapp Gateway)
NEXTSMS_OTP_TEMPLATE=
# Use NextSMS's no-send test endpoints (/api/whatsapp/v2/test/...). Nothing is delivered.
NEXTSMS_TEST_MODE=false
# Delivery Callback Verify Token registered under Customization -> Webhooks
NEXTSMS_WEBHOOK_TOKEN=
# Price per WhatsApp message in TZS for cost estimates (from nextsms.co.tz pricing; confirm on your account)
NEXTSMS_PRICE_PER_MESSAGE=12

# OTP policy
FA_OTP_TTL_MINUTES=5
FA_OTP_MAX_ATTEMPTS=5
FA_OTP_RESEND_SECONDS=60
FA_OTP_MAX_SENDS_PER_HOUR=5
FA_INVITE_TTL_DAYS=14
# Run the queue from the scheduler (only if you cannot run a supervised queue:work)
FA_QUEUE_FROM_SCHEDULER=false
